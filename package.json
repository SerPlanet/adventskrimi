{
  "name": "adventskrimi",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "app",
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -b",
    "test": "vitest run --reporter=dot",
    "build": "npm run build -w app",
    "check-bundle": "node tools/check-bundle/index.mjs",
    "db:push:staging": "supabase db push --linked",
    "validate-schema": "tsx tools/validate-schema/index.ts",
    "load-case": "tsx tools/load-case/index.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "supabase": "^2.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "pg": "^8.23.1"
  }
}
