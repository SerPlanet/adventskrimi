{
  "name": "adventskrimi",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "app",
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -b",
    "test": "vitest run --reporter=dot",
    "build": "npm run build -w app",
    "check-bundle": "node tools/check-bundle/index.mjs",
    "db:push:staging": "supabase db push --linked",
    "validate-schema": "tsx tools/validate-schema/index.ts",
    "load-case": "tsx tools/load-case/index.ts",
    "validate-case": "tsx tools/validate-case/index.ts",
    "simulate": "tsx tools/simulate/index.ts",
    "balance": "tsx tools/balance/index.ts",
    "fast-forward": "tsx tools/fast-forward/index.ts",
    "create-game": "tsx tools/create-game/index.ts",
    "build:functions": "node tools/build-functions/index.mjs",
    "test:int": "npm run build:functions && vitest run --config vitest.int.config.ts",
    "deploy:functions": "npm run build:functions && supabase functions deploy --use-api",
    "e2e": "playwright test",
    "a11y": "node tools/lighthouse/index.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.0.0",
    "lighthouse": "^13.6.0",
    "postgres": "^4.0.0",
    "prettier": "^3.3.0",
    "supabase": "^2.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "pg": "^8.23.1"
  }
}
